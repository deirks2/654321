# ─── 필수 ───────────────────────────────────────────
# Discord Developer Portal에서 발급받은 봇 토큰
DISCORD_TOKEN=여기에_디스코드_토큰_입력

# Google AI Studio에서 발급받은 Gemini API 키
GEMINI_API_KEY=여기에_제미나이_API_키_입력

# ─── 선택 ───────────────────────────────────────────
# 봇 이름 (기본값: 지피)
BOT_NAME=지피

# 최대 대화 기록 수 (기본값: 30)
MAX_HISTORY=30

# AI 성격/역할 설정 (비워두면 기본 만능 어시스턴트)
# SYSTEM_PROMPT=너는 코딩 전문 AI야. 항상 코드 예시를 포함해서 답변해.

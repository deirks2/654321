# ─── 필수 ───────────────────────────────────────────
# Discord Developer Portal에서 발급받은 봇 토큰
DISCORD_TOKEN=여기에_디스코드_토큰_입력

# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=여기에_앤트로픽_API_키_입력

# ─── 선택 ───────────────────────────────────────────
# 봇 이름 (기본값: 지피)
# "지피야 ..." 또는 "@지피 ..." 형태로 호출됨
BOT_NAME=지피

# 최대 대화 기록 수 (기본값: 30개 메시지)
MAX_HISTORY=30

# AI 시스템 프롬프트 (봇 성격/역할 설정)
# 비워두면 기본 만능 어시스턴트 프롬프트 사용
# SYSTEM_PROMPT=너는 코딩 전문 AI야. 항상 코드 예시를 포함해서 답변해.
